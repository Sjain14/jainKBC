{
  "rules": {
    "gameState": {
      ".read": true,
      ".write": "auth != null"
    },
    "questions": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "gameResults": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "audienceVotes": {
      "$questionId": {
        "$uid": {
          ".read":     "auth != null",
          ".write":    "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.isString() && (newData.val() === 'A' || newData.val() === 'B' || newData.val() === 'C' || newData.val() === 'D')"
        }
      }
    }
  }
}
